// Copy to Secrets.xcconfig (git-ignored), fill in, then `pnpm ios:generate`.
// No quotes, and no "//" in values: xcconfig reads "//" as a comment.

// The wallet's own 1Click partner key (a JWT from the 1Click partner portal).
// Confidential (FAR) quotes need one. Use a key for the wallet, not the
// issuance server's: it ships inside the app, so anyone with the app can
// read it. It only identifies the app to 1Click: it cannot move anyone's
// funds, since every movement needs the signature of the account it spends.
NEARCASH_WALLET_1CLICK_API_KEY =

// The domain the refund passkey belongs to, e.g. wallet.example.com.
// iOS creates the passkey only if that domain lists the app. Serve, over
// HTTPS, https://<domain>/.well-known/apple-app-site-association:
//   {"webcredentials": {"apps": ["<TEAM ID>.xyz.nektarlabs.nearcash.wallet"]}}
// (<TEAM ID>: the Apple Developer team that signs the app.)
// NEAR Intents does not check the domain of a passkey signature, so any
// domain of ours works; changing it later means a new passkey and a new
// refund account.
NEARCASH_PASSKEY_DOMAIN =
