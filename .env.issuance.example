# Issuance server configuration. Copy to .env.issuance (git-ignored) and fill in.
# Read by `pnpm issuance:start`, `pnpm issuance:check`, `pnpm issuer:admin`
# and `pnpm test:mpc-live`. See apps/issuance/src/config/issuance-config.ts.

# ---------------------------------------------------------------- certificates (NEAR MPC)
# The issuer contract (contracts/issuer) and the issuance server's NEAR
# account, authorised as a minter with `pnpm issuer:admin add-minter`. The key
# is a function-call key that can only call sign_certificate:
# `pnpm issuer:admin minter-key <account>`.
NEARCASH_ISSUER_CONTRACT=nearcash-issuer-xxxxxx.testnet
NEARCASH_ISSUANCE_ACCOUNT=nearcash-issuance-xxxxxx.testnet
NEARCASH_ISSUANCE_PRIVATE_KEY=ed25519:...
# NEARCASH_SIGNER=dev                 # test banknotes with the public DEV key instead
# NEARCASH_SKIP_MPC=true               # demos: the issuer contract's banknotes, but this server signs
#                                      # their certificates itself with the public DEV key (no MPC,
#                                      # no NEAR account or key needed). Wallets accept them in Debug
#                                      # builds only. `pnpm atm:demo --skip-mpc` sets it.
# NEARCASH_SKIP_BIRTH=true             # demos: cards without a birth certificate (docs/protocol.md
#                                      # §5.8) are issued too. Only with NEARCASH_SKIP_MPC=true or the
#                                      # dev signer: the issuer contract always checks it.
#                                      # `pnpm atm:demo --skip-birth` sets it.
# NEARCASH_NEAR_RPC=https://test.rpc.fastnear.com
# NEARCASH_MPC_CONTRACT=v1.signer-prod.testnet
# NEARCASH_CERTIFICATE_PATH=nearcash-certificates-v1

# ---------------------------------------------------------------- ATMs
# Allowed ATMs, name:token, comma separated. ATMs hold no keys: the token
# only lets them ask for quotes and certificates of paid sales.
NEARCASH_ATM_TOKENS=atm-duomo:change-me
# NEARCASH_ISSUANCE_PORT=8790
# NEARCASH_ISSUANCE_HOST=127.0.0.1             # 0.0.0.0: reachable from an ATM on the LAN (demo)
# NEARCASH_ISSUANCE_STORE=issuance-sales.json   # sales (one payment = one card); keep it safe

# ---------------------------------------------------------------- payments
# simulated (development) or 1click. Check everything live, without moving
# money, with `pnpm issuance:check`.
NEARCASH_PAYMENTS=simulated
# NEARCASH_1CLICK_URL=https://1click.chaindefuser.com
# Everything on FAR (CONFIDENTIAL_INTENTS) needs the 1Click partner key: the
# JWT from partners.near-intents.org, sent as X-API-Key. Paste it as it is,
# without quotes or brackets. The server refuses to start without it.
# NEARCASH_1CLICK_API_KEY=eyJ...
# NEARCASH_1CLICK_RECIPIENT_TYPE=CONFIDENTIAL_INTENTS   # deposits into FAR (default)

# ---------------------------------------------------------------- reserve (FAR)
# simulated (development) or far. The reserve is the issuance server's own
# account inside FAR: every payment lands there (1Click recipient), and it
# sends each banknote's value to the card's account with a FAR → FAR transfer
# made through 1Click (only the partner key above is needed).
NEARCASH_RESERVE=simulated
# Its account and key: an implicit account (the hex of the ed25519 public
# key) needs no registration. Whoever has the key can spend the reserve.
# NEARCASH_RESERVE_ACCOUNT=<64 hex digits>
# NEARCASH_RESERVE_PRIVATE_KEY=ed25519:...
# NEARCASH_FAR_CONTRACT=intents.far                 # default
# The token customers pay into the reserve and the reserve sends to cards, as
# 1Click names it (default: the issuer contract's token). Needed while the
# issuer contract still names a placeholder token. The banknotes are backed
# by USDC on Ethereum (6 decimals, as the contract's denominations assume):
# NEARCASH_RESERVE_TOKEN=nep141:eth-0xa0b86991c6218b36c1d19d4a2e9eb0ce3606eb48.omft.near
# Customers paying in USDC on another chain send exactly the banknote's
# value and the bank pays the conversion (about 0.02 %): keep a little of
# this token in the reserve (e.g. 1 USDC) to cover it, or a card can't be funded.
# To send it from Base: pnpm issuance:fund-reserve 1

# ---------------------------------------------------------------- refunds
# Customers who give no refund address are refunded into the reserve (a
# failed swap, a late payment, an overpayment); the server sends the money
# back to the address that paid, reading who paid from the origin chain.
# NEARCASH_REFUND_SWEEP_SECONDS=60             # how often to look (default 10 with simulated payments; 0: never)
# NEARCASH_REFUND_WATCH_HOURS=24               # how long after a sale's deadline
# NEARCASH_REFUNDS_STORE=issuance-refunds.json # every refund sent back or kept; keep it safe
# Public mainnet endpoints by default; use your own provider for production.
# NEARCASH_RPC_BASE=https://mainnet.base.org
# NEARCASH_RPC_ARBITRUM=https://arb1.arbitrum.io/rpc
# NEARCASH_RPC_ETHEREUM=https://ethereum-rpc.publicnode.com
# NEARCASH_RPC_SOLANA=https://api.mainnet-beta.solana.com
# NEARCASH_RPC_NEAR=https://free.rpc.fastnear.com
# NEARCASH_NEARBLOCKS_URL=https://api.nearblocks.io  # tells a NEAR transaction's signer
# NEARCASH_SIMULATED_REFUND_FEE=1000           # simulated payments: refunds up to this are "too small"

# ---------------------------------------------------------------- live check
# NEARCASH_CHECK_ORIGIN_ASSET=nep141:base-0x833589fcd6edb6e08f4c7c32d4f71b54bda02913.omft.near
# Without it the check quotes refund into the reserve, as for customers who
# give no refund address; with it, to this address on the origin chain.
# NEARCASH_CHECK_REFUND_TO=0x…                      # any lowercase address you control
