# ATM configuration (the Raspberry Pi inside the ATM). Copy to .env.atm
# (git-ignored) and fill in. Two programs run on the Pi and both read it:
#   - the ATM server (apps/atm, `pnpm atm:start`): the sale, the cassette, the
#     dispenser; listens on the Pi only;
#   - the kiosk page (apps/kiosk, `pnpm kiosk:preview`): what the iPhone shows;
#     forwards /api to the ATM server.

# ---------------------------------------------------------------- issuance server
# The ATM holds no key that creates value: this token only lets it ask the
# issuance server for quotes and for the certificates of paid sales. It must
# be one of the server's NEARCASH_ATM_TOKENS.
NEARCASH_ISSUANCE_URL=https://issuance.example.com
NEARCASH_ATM_TOKEN=change-me
# Issuer key (hex, compressed secp256k1) every dispensed card must verify
# against. Leave unset only in development (it is then asked to the server).
# NEARCASH_TRUSTED_ISSUER=02...

# ---------------------------------------------------------------- ATM server (apps/atm)
# NEARCASH_ATM_HOST=127.0.0.1         # only the kiosk page (same Pi) calls it
# NEARCASH_ATM_PORT=8792
# Pairing key: only a screen that knows it can drive the ATM. Generate one
# with `openssl rand -hex 24` and open https://<raspberry>:8791/#key=<key>
# once on the iPhone.
NEARCASH_KIOSK_KEY=

# ---------------------------------------------------------------- kiosk page (apps/kiosk)
# The iPhone on the front of the ATM opens https://<raspberry>:8791.
# NEARCASH_KIOSK_HOST=0.0.0.0
# NEARCASH_KIOSK_PORT=8791
# NEARCASH_ATM_SERVER_URL=http://127.0.0.1:8792   # where the page forwards /api
# HTTPS, so the pairing key never crosses the Wi-Fi in clear. A certificate
# from a local CA that the iPhone trusts (pnpm atm:demo makes one with mkcert).
# NEARCASH_KIOSK_TLS_CERT=/home/pi/nearcash/.atm-tls/atm.pem
# NEARCASH_KIOSK_TLS_KEY=/home/pi/nearcash/.atm-tls/atm-key.pem

# ---------------------------------------------------------------- hardware
# No NFC reader driver yet (the reader and the cards are on their way): with
# NEARCASH_CASSETTE=none the kiosk shows "out of service" and no sale can
# start. The dispenser only logs until its motor is wired.
NEARCASH_CASSETTE=none
NEARCASH_DISPENSER=sim
