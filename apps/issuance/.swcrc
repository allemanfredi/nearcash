{
  "$schema": "https://swc.rs/schema.json",
  "jsc": {
    "parser": { "syntax": "typescript", "decorators": true },
    "transform": { "legacyDecorator": true, "decoratorMetadata": true, "useDefineForClassFields": false },
    "target": "es2022",
    "keepClassNames": true,
    "rewriteRelativeImportExtensions": true
  },
  "module": { "type": "es6" },
  "sourceMaps": true
}
